# OpinionNG Environment Configuration

# App
VITE_APP_NAME="OpinionNG"
VITE_APP_ENV="development"
VITE_APP_URL="http://localhost:5173"

# Default Demo Wallet Funding
VITE_DEFAULT_DEMO_BALANCE_KOBO=1000000 # ₦10,000 in Kobo

# Database (Supabase / Postgres / Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/opinion_ng?schema=public"
# SUPABASE_URL=""
# SUPABASE_ANON_KEY=""

# Payments & Settlement (Paystack / Monnify / Flutterwave for Naira virtual accounts)
PAYSTACK_PUBLIC_KEY="pk_test_sample"
PAYSTACK_SECRET_KEY="sk_test_sample"
# FLUTTERWAVE_PUBLIC_KEY=""
# MONNIFY_API_KEY=""

# Twitter / X OAuth 2.0 (for X mentions, creator recognition & verification)
X_CLIENT_ID=""
X_CLIENT_SECRET=""
X_CALLBACK_URL="http://localhost:5173/auth/callback/x"

# SMS OTP Provider (Termii / Twilio / KudiSMS for Nigerian phone verification)
TERMII_API_KEY=""
TERMII_SENDER_ID="OpinionNG"

